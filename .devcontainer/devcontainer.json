{
    "name": "Copilot on AKS (Codespaces)",
    // Use Microsoft' Universal base for fastest startup
    "image": "mcr.microsoft.com/devcontainers/universal:2",
  
    // Add extra tools via a Dockerfile layer
    "features": {
      // Node 20 LTS via devcontainer-features registry
      "ghcr.io/devcontainers/features/node:1": {
        "version": "20"
      },
      // Azure CLI (includes kubelogin)
      "ghcr.io/devcontainers/features/azure-cli:1": {},
      // kubectl + Helm
      "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
        "kubectl": "latest",
        "helm": "latest",
        "minikube": "none"
      },
      //Docker in Docker
      "ghcr.io/devcontainers/features/docker-in-docker:2": {},
          // ➕ PowerShell Core
      "ghcr.io/devcontainers/features/powershell:1": {}
    },
  
    // The workspace folder is the repo root in Codespaces
    "postCreateCommand": [
      // wait until DinD is ready, then install deps
      "sudo service docker start && while ! docker info >/dev/null 2>&1; do sleep 1; done",
      "npm install --prefix 05-deploy-with-aks"
    ],
  
    // Recommended VS Code extensions for the lab
    "extensions": [
      "ms-azuretools.vscode-docker",
      "ms-azuretools.vscode-azurecli",
      "dbaeumer.vscode-eslint",
      "GitHub.copilot",
      "GitHub.copilot-chat"  
    ],
  
    // Forward the sample app port
    "forwardPorts": [3000]
  }
  